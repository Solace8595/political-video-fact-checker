@startuml
left to right direction

actor "Блогер / автор\nаналитического контента" as Blogger
actor "Пользователь,\nинтересующийся политикой" as User
actor "Разработчик системы" as Developer

rectangle "Система автоматической верификации фактов" {

    usecase "UC-01 [FR-01]\nЗагрузить видео\nили указать ссылку" as UC01
    usecase "UC-02 [FR-02]\nПроверить видеоматериал" as UC02
    usecase "UC-03 [FR-03]\nИзвлечь аудиодорожку" as UC03
    usecase "UC-04 [FR-04]\nРаспознать речь" as UC04
    usecase "UC-05 [FR-05]\nВыделить фактические\nутверждения" as UC05
    usecase "UC-06 [FR-06]\nКлассифицировать\nутверждения" as UC06
    usecase "UC-07 [FR-07]\nПросмотреть утверждения\nи транскрипцию" as UC07
    usecase "UC-08 [FR-08]\nРедактировать утверждения" as UC08
    usecase "UC-09 [FR-09]\nНайти информацию\nв разрешённых источниках" as UC09
    usecase "UC-10 [FR-11]\nСопоставить утверждения\nс найденными сведениями" as UC10
    usecase "UC-11 [FR-12]\nОпределить статус проверки" as UC11
    usecase "UC-12 [FR-13]\nПросмотреть обоснование\nи источники" as UC12
    usecase "UC-13 [FR-14]\nСформировать итоговый отчёт" as UC13
    usecase "UC-14 [FR-10, FR-15]\nУправлять списком\nразрешённых источников" as UC14
    usecase "UC-15 [FR-16]\nСохранить или экспортировать\nотчёт" as UC15
}

Blogger -- UC01
Blogger -- UC07
Blogger -- UC08
Blogger -- UC09
Blogger -- UC12
Blogger -- UC13
Blogger -- UC15

User -- UC01
User -- UC07
User -- UC08
User -- UC09
User -- UC12
User -- UC13
User -- UC15

Developer -- UC14

UC01 ..> UC02 : <<include>>
UC02 ..> UC03 : <<include>>
UC03 ..> UC04 : <<include>>
UC04 ..> UC05 : <<include>>

UC06 ..> UC05 : <<extend>>

UC09 ..> UC10 : <<include>>
UC10 ..> UC11 : <<include>>

UC13 ..> UC11 : <<include>>

UC15 ..> UC13 : <<extend>>

@enduml
